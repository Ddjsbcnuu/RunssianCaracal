local ESPObjects = {}
local VisClock = {}
local VisFrac = {}
local function CreateESP(NPC)
    if ESPObjects[NPC] then return end
    local t = {
        Box = Drawing.new("Square"), Name = Drawing.new("Text"), Dist = Drawing.new("Text"),
        Tracer = Drawing.new("Line"), HealthBG = Drawing.new("Square"), Health = Drawing.new("Square"),
        Corners = {},
    }
    t.Box.Thickness, t.Box.Filled = 1, false
    t.Name.Center, t.Name.Outline, t.Name.Size = true, true, 13
    t.Dist.Center, t.Dist.Outline, t.Dist.Size = true, true, 13
    t.Tracer.Thickness = 1
    t.HealthBG.Filled, t.HealthBG.Thickness, t.HealthBG.Color = true, 1, Color3.new(0, 0, 0)
    t.Health.Filled, t.Health.Thickness = true, 1
    for i = 1, 8 do
        local line = Drawing.new("Line")
        line.Thickness, line.Visible = 1, false
        t.Corners[i] = line
    end
    ESPObjects[NPC] = t
end
local function HideESP(t)
    for key, d in pairs(t) do
        if key == "Corners" then
            for _, line in pairs(d) do line.Visible = false end
        else
            d.Visible = false
        end
    end
end
local function RemoveESP(NPC)
    local t = ESPObjects[NPC]
    if not t then return end
    for key, d in pairs(t) do
        if key == "Corners" then
            for _, line in pairs(d) do pcall(function() line:Remove() end) end
        else
            pcall(function() d:Remove() end)
        end
    end
    ESPObjects[NPC] = nil
    VisClock[NPC] = nil
    VisFrac[NPC] = nil
end
for _, NPC in pairs(NPCFolder:GetChildren()) do CreateESP(NPC) end
Add(NPCFolder.ChildAdded:Connect(CreateESP))
Add(NPCFolder.ChildRemoved:Connect(RemoveESP))

local VisInterval = 0.1
Add(RunService.RenderStepped:Connect(function(dt)
    if not Toggles.ESPEnabled.Value then
        for _, t in pairs(ESPObjects) do HideESP(t) end
        return
    end
    local vp = Camera.ViewportSize
    local camPos = Camera.CFrame.Position
    local visOn = Toggles.ESPVisCheck.Value
    local sens = Options.ESPVisSensitivity.Value / 100
    local baseCol = Options.ESPColor.Value
    local visCol = Options.ESPVisibleColor.Value
    local hidCol = Options.ESPHiddenColor.Value
    local distCheck = Toggles.ESPDistCheck.Value
    local distLimit = Options.ESPDistance.Value
    for NPC, t in pairs(ESPObjects) do
        local root = NPC:FindFirstChild("HumanoidRootPart") or NPC:FindFirstChild("Torso") or NPC.PrimaryPart
        if not root then HideESP(t) continue end
        local rp = root.Position
        local pos, on = Camera:WorldToViewportPoint(rp)
        local dist = (camPos - rp).Magnitude
        if not on or (distCheck and dist > distLimit) then HideESP(t) continue end
        local topV = Camera:WorldToViewportPoint(rp + Vector3.new(0, 3, 0))
        local botV = Camera:WorldToViewportPoint(rp - Vector3.new(0, 3, 0))
        local h = math.max(math.abs(topV.Y - botV.Y), 20)
        local w = h * 0.5
        local topY = math.min(topV.Y, botV.Y)
        local col = baseCol
        if visOn then
            local clock = (VisClock[NPC] or 0) + dt
            local frac = VisFrac[NPC]
            if frac == nil or clock >= VisInterval then
                clock = 0
                frac = VisibleFraction(NPC)
                VisFrac[NPC] = frac
            end
            VisClock[NPC] = clock
            if frac >= sens then col = visCol else col = hidCol end
        end
        local boxX = pos.X - w / 2
        local corner = Toggles.ESPCorner.Value
        t.Box.Visible = Toggles.ESPBox.Value and not corner
        t.Box.Size = Vector2.new(w, h)
        t.Box.Position = Vector2.new(boxX, topY)
        t.Box.Color = col
        if Toggles.ESPBox.Value and corner then
            local len = math.max(w * 0.25, 4)
            local C = t.Corners
            for _, line in pairs(C) do line.Visible = true line.Color = col end
            local x1, y1, x2, y2 = boxX, topY, boxX + w, topY + h
            C[1].From, C[1].To = Vector2.new(x1, y1), Vector2.new(x1 + len, y1)
            C[2].From, C[2].To = Vector2.new(x1, y1), Vector2.new(x1, y1 + len)
            C[3].From, C[3].To = Vector2.new(x2, y1), Vector2.new(x2 - len, y1)
            C[4].From, C[4].To = Vector2.new(x2, y1), Vector2.new(x2, y1 + len)
            C[5].From, C[5].To = Vector2.new(x1, y2), Vector2.new(x1 + len, y2)
            C[6].From, C[6].To = Vector2.new(x1, y2), Vector2.new(x1, y2 - len)
            C[7].From, C[7].To = Vector2.new(x2, y2), Vector2.new(x2 - len, y2)
            C[8].From, C[8].To = Vector2.new(x2, y2), Vector2.new(x2, y2 - len)
        else
            for _, line in pairs(t.Corners) do line.Visible = false end
        end
        t.Name.Visible = Toggles.ESPName.Value
        t.Name.Text = NPC.Name
        t.Name.Position = Vector2.new(pos.X, topY - 16)
        t.Name.Color = col
        t.Dist.Visible = Toggles.ESPDist.Value
        t.Dist.Text = string.format("%dm", math.floor(dist))
        t.Dist.Position = Vector2.new(pos.X, topY + h + 2)
        t.Dist.Color = col
        t.Tracer.Visible = Toggles.ESPTracer.Value
        t.Tracer.From = Vector2.new(vp.X / 2, vp.Y)
        t.Tracer.To = Vector2.new(pos.X, topY + h)
        t.Tracer.Color = col
        local hum = NPC:FindFirstChildOfClass("Humanoid")
        if Toggles.ESPHealth.Value and hum and hum.MaxHealth > 0 then
            local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local x = boxX - 5
            t.HealthBG.Visible = true
            t.HealthBG.Size = Vector2.new(3, h)
            t.HealthBG.Position = Vector2.new(x, topY)
            t.Health.Visible = true
            t.Health.Size = Vector2.new(3, h * frac)
            t.Health.Position = Vector2.new(x, topY + h * (1 - frac))
            t.Health.Color = Color3.fromRGB(math.floor(255 * (1 - frac)), math.floor(255 * frac), 0)
        else
            t.HealthBG.Visible, t.Health.Visible = false, false
        end
    end
end))

