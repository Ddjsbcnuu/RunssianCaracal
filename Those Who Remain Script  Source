-- SIGNAL ANTICHEAT BYPASS PATCH (안정화 v1.1)
-- 기존 Signal 스크립트의 HOOKS 섹션(라인 800~852)을 이걸로 교체
--
-- 탐지 벡터 4개를 모두 처리:
-- 1. UpdateAngle ↔ Fire.Direction 불일치 → 발사 시 Angle 스푸핑
-- 2. Fire.PosCF rot ↔ Direction 불일치 → PosCF 회전값도 스푸핑
-- 3. Fire.Mag 카운트 안 줄어듦 → 서버에 보내는 Mag을 감소시킴
-- 4. UpdateMag 동기화 → 가짜 Mag 값 전송
--============================================================

-- HOOKS
--============================================================

local _spoofedDirection = nil
local _spoofedOrigin = nil

local _fakeMag = nil
local _fakePool = nil
local _weaponMaxMag = nil
local _weaponMaxPool = nil
local RE = ReplicatedStorage:WaitForChild("RE")
local _isReloading = false
local _reloadTime = 2.0

-- 유틸: 방향벡터 → (yaw, pitch) 안전 변환
local function dirToAngles(dir)
    local mag = dir.Magnitude
    if mag < 0.001 then return 0, 0 end
    return math.atan2(-dir.X, -dir.Z),
           math.asin(math.clamp(dir.Y / mag, -1, 1))
end

local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(Self, ...)
    if getnamecallmethod() == "FireServer" then
        local Args = {...}

        if Args[1] == "CheatKick" then return end

        if Args[1] == "GlobalReplicate" and type(Args[2]) == "table" then
            local data = Args[2]

            -----------------------------------------------
            -- [패치 1] UpdateAngle 스푸핑
            -----------------------------------------------
            if data.Type == "UpdateAngle" and _spoofedDirection then
                local yaw, pitch = dirToAngles(_spoofedDirection)

                local jitterY = (math.random() - 0.5) * 0.0087
                local jitterX = (math.random() - 0.5) * 0.0087

                data.Angle = {
                    y = yaw + jitterY,
                    x = pitch + jitterX,
                    ToAngle = {y = 0, x = 0}
                }
                Args[2] = data
                return OldNamecall(Self, unpack(Args))
            end

            -----------------------------------------------
            -- [패치 2] Fire 이벤트 스푸핑
            -----------------------------------------------
            if data.Type == "Fire" then
                if _isReloading then
                    _spoofedDirection = nil
                    _spoofedOrigin = nil
                    return
                end

                if _spoofedDirection then
                    data.Direction = _spoofedDirection
                    local camPos = Camera.CFrame.Position
                    data.PosCF = CFrame.new(camPos, camPos + _spoofedDirection)
                end

                if _fakeMag ~= nil and Toggles.InfMag.Value then
                    _fakeMag = _fakeMag - 1
                    if _fakeMag < 0 then _fakeMag = 0 end
                    data.Mag = _fakeMag

                    if _fakeMag == 0 then
                        _isReloading = true
                        task.spawn(function()
                            task.wait(0.05)
                            RE:FireServer("GlobalReplicate", {
                                Mag = 0,
                                Type = "Reload",
                                ReloadTable = {
                                    CurrentMag = 0,
                                    Type = "Whole",
                                    CanPull = false,
                                    Add = (_fakePool ~= nil and Toggles.InfPool.Value)
                                        and math.min(_weaponMaxMag, _fakePool)
                                        or _weaponMaxMag
                                }
                            })
                            task.wait(_reloadTime + math.random() * 0.4)
                            RE:FireServer("UpdateMag", { Mag = _weaponMaxMag })
                            _fakeMag = _weaponMaxMag
                            if _fakePool ~= nil and Toggles.InfPool.Value then
                                _fakePool = _fakePool - _weaponMaxMag
                                if _fakePool < _weaponMaxMag then
                                    _fakePool = _weaponMaxPool
                                end
                            end
                            _isReloading = false
                        end)
                    end
                end

                Args[2] = data
                _spoofedDirection = nil
                _spoofedOrigin = nil
                return OldNamecall(Self, unpack(Args))
            end

            -----------------------------------------------
            -- [패치 3] Reload
            -----------------------------------------------
            if data.Type == "Reload" then
                if Toggles.InfPool.Value and _fakeMag ~= nil and _fakeMag > 0 then
                    return
                end
                if _weaponMaxMag then
                    _fakeMag = _weaponMaxMag
                    data.Mag = 0
                    local addAmt = _weaponMaxMag
                    if _fakePool ~= nil and Toggles.InfPool.Value then
                        addAmt = math.min(_weaponMaxMag, _fakePool)
                        _fakePool = _fakePool - addAmt
                        if _fakePool < _weaponMaxMag then
                            _fakePool = _weaponMaxPool
                        end
                    end
                    if data.ReloadTable then
                        data.ReloadTable.CurrentMag = 0
                        data.ReloadTable.Add = addAmt
                    end
                end
                Args[2] = data
                return OldNamecall(Self, unpack(Args))
            end

            -----------------------------------------------
            -- [패치 4] Equip
            -----------------------------------------------
            if data.Type == "Equip" then
                if data.Mag then
                    _fakeMag = data.Mag
                    _weaponMaxMag = data.Mag
                end
            end

            -----------------------------------------------
            -- [패치 5] AddState/RemoveState
            -----------------------------------------------
            if (data.Type == "AddState" or data.Type == "RemoveState") then
                if _fakeMag ~= nil and Toggles.InfMag.Value then
                    data.Mag = _fakeMag
                    Args[2] = data
                    return OldNamecall(Self, unpack(Args))
                end
            end
        end

        -----------------------------------------------
        -- [패치 6] UpdateMag
        -----------------------------------------------
        if Args[1] == "UpdateMag" and type(Args[2]) == "table" then
            if _fakeMag ~= nil and Toggles.InfMag.Value then
                Args[2].Mag = _fakeMag
                return OldNamecall(Self, unpack(Args))
            end
        end
    end

    return OldNamecall(Self, ...)
end)

