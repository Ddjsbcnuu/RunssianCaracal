local function KeyHeld(opt)
    local key = opt and opt.Value
    if type(key) ~= "string" or key == "" then key = "MB2" end
    local mb = MouseButtons[key]
    if mb then return Held[mb] == true end
    local ok, enum = pcall(function() return Enum.KeyCode[key] end)
    if ok and enum then return Held[enum] == true end
    return false
end

