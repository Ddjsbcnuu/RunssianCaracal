local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local function PlayAlert(pitch)
    if not Toggles.PlayerAlertSound.Value then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://12222253"
        s.Volume = 1
        s.PlaybackSpeed = pitch or 1
        s.Parent = SoundService
        s:Play()
        Debris:AddItem(s, 3)
    end)
end
Add(PlayerService.PlayerAdded:Connect(function(plr)
    if not Toggles.PlayerAlerts.Value then return end
    Notify("Player Joined", string.format("%s (@%s)\nPlayers: %d / %d",
        plr.DisplayName, plr.Name, #PlayerService:GetPlayers(), PlayerService.MaxPlayers), 5)
    PlayAlert(1)
end))
Add(PlayerService.PlayerRemoving:Connect(function(plr)
    if not Toggles.PlayerAlerts.Value then return end
    local remaining = 0
    for _, p in ipairs(PlayerService:GetPlayers()) do
        if p ~= plr then remaining = remaining + 1 end
    end
    Notify("Player Left", string.format("%s (@%s)\nPlayers: %d / %d",
        plr.DisplayName, plr.Name, remaining, PlayerService.MaxPlayers), 5)
    PlayAlert(0.7)
end))

