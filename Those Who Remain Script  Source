local WallCheckParams = RaycastParams.new()
WallCheckParams.FilterType = Enum.RaycastFilterType.Blacklist
WallCheckParams.IgnoreWater = true
local function Raycast(Origin, Direction, Filter)
    WallCheckParams.FilterDescendantsInstances = Filter
    return Workspace:Raycast(Origin, Direction, WallCheckParams)
end

local ESPVisParams = RaycastParams.new()
ESPVisParams.FilterType = Enum.RaycastFilterType.Blacklist
ESPVisParams.IgnoreWater = true
local SelfZone = 6
local function IsBehindWall(NPC, TargetPosition)
    local Origin = Camera.CFrame.Position
    local TargetDist = (TargetPosition - Origin).Magnitude
    local Ignore = {Camera, NPCFolder, Items}
    if LocalPlayer.Character then Ignore[#Ignore + 1] = LocalPlayer.Character end
    for _ = 1, 8 do
        ESPVisParams.FilterDescendantsInstances = Ignore
        local Result = Workspace:Raycast(Origin, TargetPosition - Origin, ESPVisParams)
        if not Result then return false end
        local HitDist = (Result.Position - Origin).Magnitude
        if HitDist >= TargetDist - 2 then return false end
        if Result.Instance:IsDescendantOf(NPC) then return false end
        if HitDist > SelfZone then return true end
        Ignore[#Ignore + 1] = Result.Instance
    end
    return false
end
local VisCheckParts = {"Head", "Torso", "HumanoidRootPart", "Left Leg", "Right Leg", "Left Arm", "Right Arm"}
local function VisibleFraction(NPC)
    local total, visible = 0, 0
    for _, name in ipairs(VisCheckParts) do
        local part = NPC:FindFirstChild(name)
        if part then
            total = total + 1
            if not IsBehindWall(NPC, part.Position) then visible = visible + 1 end
        end
    end
    if total == 0 then return 0 end
    return visible / total
end
local function IsDistanceLimited(Enabled, Distance, Limit)
    if not Enabled then return end
    return Distance >= Limit
end
local function IsVisible(Enabled, Origin, Position, Character)
    if not Enabled then return true end
    return not Raycast(Origin, Position - Origin, {Character, LocalPlayer.Character})
end
local function GetClosest(Enabled, VisibilityCheck, DistanceCheck, DistanceLimit, FieldOfView, Priority, BodyParts)
    if not Enabled then return end
    local CameraPosition, Closest = Camera.CFrame.Position, nil
    local RootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local MyPosition = RootPart and RootPart.Position or CameraPosition
    local AuraMode = Priority == "Aura Distance"
    local CrosshairMode = Priority == "Crosshair"
    local BestScore = AuraMode and math.huge or FieldOfView
    for Index, NPC in pairs(NPCFolder:GetChildren()) do
        for Index, BodyPart in pairs(BodyParts) do
            BodyPart = NPC:FindFirstChild(BodyPart)
            if not BodyPart then continue end
            local BodyPartPosition = BodyPart.Position
            local Distance = (BodyPartPosition - CameraPosition).Magnitude
            if IsDistanceLimited(DistanceCheck, Distance, DistanceLimit) then continue end
            if not CrosshairMode and not IsVisible(VisibilityCheck, CameraPosition, BodyPartPosition, NPC) then continue end
            local ScreenPosition, OnScreen = Camera:WorldToViewportPoint(BodyPartPosition)
            if not OnScreen then continue end
            local Magnitude = (Vector2.new(ScreenPosition.X, ScreenPosition.Y) - UserInputService:GetMouseLocation()).Magnitude
            if Magnitude >= FieldOfView then continue end
            local ActualPriority = Priority
            if AuraMode or CrosshairMode then ActualPriority = "Closest" end
            if ActualPriority == "Random" then
                ActualPriority = KnownBodyParts[math.random(#KnownBodyParts)][1]
                BodyPart = NPC:FindFirstChild(ActualPriority)
                if not BodyPart then continue end
                BodyPartPosition = BodyPart.Position
                ScreenPosition, OnScreen = Camera:WorldToViewportPoint(BodyPartPosition)
            elseif ActualPriority ~= "Closest" then
                BodyPart = NPC:FindFirstChild(ActualPriority)
                if not BodyPart then continue end
                BodyPartPosition = BodyPart.Position
                ScreenPosition, OnScreen = Camera:WorldToViewportPoint(BodyPartPosition)
            end
            if AuraMode then
                if IsBehindWall(NPC, BodyPartPosition) then continue end
                local WorldDistance = (BodyPartPosition - MyPosition).Magnitude
                if WorldDistance < BestScore then
                    BestScore, Closest = WorldDistance, {NPC, NPC, BodyPart, ScreenPosition}
                end
            else
                FieldOfView, Closest = Magnitude, {NPC, NPC, BodyPart, ScreenPosition}
            end
        end
    end
    return Closest
end
local function MoveMouse(dx, dy)
    if pcall(function() mousemoverel(dx, dy) end) then return end
    pcall(function() mousemoverel(Vector2.new(dx, dy)) end)
end
local function AimAt(Hitbox, Sensitivity, Method)
    if not Hitbox then return end
    local part = Hitbox[3]
    if not part then return end
    if Method == "Camera Lock" then
        local camCF = Camera.CFrame
        local goal = CFrame.new(camCF.Position, part.Position)
        Camera.CFrame = camCF:Lerp(goal, math.clamp(Sensitivity, 0, 1))
    else
        local screen = Hitbox[4]
        local mouse = UserInputService:GetMouseLocation()
        MoveMouse((screen.X - mouse.X) * Sensitivity, (screen.Y - mouse.Y) * Sensitivity)
    end
end
local function GetNearest360(Range, VisCheck)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = root and root.Position or Camera.CFrame.Position
    local best, bestDist = nil, Range
    for _, NPC in pairs(NPCFolder:GetChildren()) do
        local hrp = NPC:FindFirstChild("HumanoidRootPart") or NPC:FindFirstChild("Torso")
        if hrp then
            local d = (hrp.Position - myPos).Magnitude
            if d < bestDist then
                local aimPart = NPC:FindFirstChild("Head") or hrp
                if not VisCheck or d < 15 or not IsBehindWall(NPC, aimPart.Position) then
                    bestDist = d
                    best = {NPC, NPC, aimPart, nil}
                end
            end
        end
    end
    return best
end
local LockedNPC = nil
local function ResolveTarget(Range, VisCheck)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = root and root.Position or Camera.CFrame.Position
    if LockedNPC then
        local npc = LockedNPC
        local hrp = npc.Parent and (npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso"))
        local hum = npc:FindFirstChildOfClass("Humanoid")
        local ok = hrp ~= nil and (not hum or hum.Health > 0)
        if ok then
            local d = (hrp.Position - myPos).Magnitude
            if d > Range then ok = false end
            if ok and VisCheck and d >= 15 then
                local head = npc:FindFirstChild("Head") or hrp
                if IsBehindWall(npc, head.Position) then ok = false end
            end
        end
        if not ok then LockedNPC = nil end
    end
    if not LockedNPC then
        local best = GetNearest360(Range, VisCheck)
        if best then LockedNPC = best[1] end
    end
    if not LockedNPC then return nil end
    local npc = LockedNPC
    local hrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso")
    local aimPart = npc:FindFirstChild("Head") or hrp
    if not aimPart then LockedNPC = nil return nil end
    return { npc, npc, aimPart, nil }
end

