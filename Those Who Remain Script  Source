local OldInteractUpdate = Interact.Update
Interact.Update = function(Self, ...)
    local Args = {...}
    if Args[1].Equipped then
        local Weapon = Args[3][Args[1].Equipped]
        local WeaponStats = Args[1].WeaponModule.Stats

        if WeaponStats.Mag and _weaponMaxMag ~= WeaponStats.Mag then
            _weaponMaxMag = WeaponStats.Mag
            _fakeMag = WeaponStats.Mag
        end
        if WeaponStats.Pool and _weaponMaxPool ~= WeaponStats.Pool then
            _weaponMaxPool = WeaponStats.Pool
            _fakePool = WeaponStats.Pool
        end

        local rt = WeaponStats.ReloadTime
        if type(rt) == "number" and rt > 0 then
            _reloadTime = rt
        end

        if WeaponStats.Mag and Toggles.InfMag.Value then Weapon.Mag = WeaponStats.Mag end
                if WeaponStats.Pool and Toggles.InfPool.Value then
            if Weapon.Pool < _weaponMaxMag then
                Weapon.Pool = Weapon.Pool + _weaponMaxMag
            end
        end
        return OldInteractUpdate(Self, unpack(Args))
    end
    return OldInteractUpdate(...)
end

