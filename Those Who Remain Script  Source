local OldCast = RayModule.Cast
RayModule.Cast = function(...)
    local Args = {...}
    if SilentAim and Args[4] == Enum.RaycastFilterType.Blacklist then
        if Toggles.Wallbang.Value then
            Args[4] = Enum.RaycastFilterType.Whitelist
            Args[3] = {SilentAim[2]}
        end
        if math.random(100) <= Options.SilentHitChance.Value then
            local part = SilentAim[3]
            local center = part.Position

            local blockWhenHidden = false
            if Toggles.InstantHitVisCheck.Value then
                blockWhenHidden = VisibleFraction(SilentAim[1]) < (Options.IHVisSensitivity.Value / 100)
            end

            if Toggles.InstantHit.Value and not blockWhenHidden then
                local front = part.CFrame * CFrame.new(Options.IHOffX.Value, Options.IHOffY.Value, Options.IHOffZ.Value)
                local diff = center - front.Position
                Args[1] = front.Position
                Args[2] = diff
                if diff.Magnitude > 0.001 then
                    _spoofedDirection = diff.Unit
                end
                _spoofedOrigin = front.Position
            else
                local diff = center - Camera.CFrame.Position
                Args[1] = Camera.CFrame.Position
                Args[2] = diff
                if diff.Magnitude > 0.001 then
                    _spoofedDirection = diff.Unit
                end
                _spoofedOrigin = nil
            end
        end
        return OldCast(unpack(Args))
    end
    return OldCast(...)
end

