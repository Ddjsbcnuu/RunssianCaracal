local AutoNormalTarget = nil
local AutoNormalAligned = false
local calX, calY, calStage, calBefore = nil, nil, 0, nil
local CAL = 50
local function yawOf(cf) return math.atan2(-cf.LookVector.X, -cf.LookVector.Z) end
local function pitchOf(cf) return math.asin(math.clamp(cf.LookVector.Y, -1, 1)) end
local function wrapAngle(a) return (a + math.pi) % (2 * math.pi) - math.pi end

pcall(function() RunService:UnbindFromRenderStep("SignalAutoAim") end)
RunService:BindToRenderStep("SignalAutoAim", Enum.RenderPriority.Camera.Value + 2, function()
    if not Toggles.AutoBot.Value or Options.AutoBotType.Value ~= "Normal" or not isrbxactive() then
        AutoNormalTarget, AutoNormalAligned = nil, false
        calStage, calX, calY = 0, nil, nil
        return
    end
    -- measure mouse sensitivity once (angle change per mouse unit)
    if not calX or not calY then
        if calStage == 0 then
            calBefore = Camera.CFrame
            MoveMouse(CAL, 0)
            calStage = 1
        elseif calStage == 1 then
            local d = wrapAngle(yawOf(Camera.CFrame) - yawOf(calBefore))
            if math.abs(d) >= 0.0005 then calX = d / CAL end
            calBefore = Camera.CFrame
            MoveMouse(0, CAL)
            calStage = 2
        else
            local d = pitchOf(Camera.CFrame) - pitchOf(calBefore)
            if math.abs(d) >= 0.0005 then calY = d / CAL end
            calStage = 0
        end
        return
    end
    local target = ResolveTarget(Options.AutoBotRange.Value, true)
    AutoNormalTarget = target
    AutoNormalAligned = false
    if target and target[3] then
        local camCF = Camera.CFrame
        local dir = target[3].Position - camCF.Position
        if dir.Magnitude > 0.01 then
            local tYaw = math.atan2(-dir.X, -dir.Z)
            local tPitch = math.asin(math.clamp(dir.Unit.Y, -1, 1))
            local yawErr = wrapAngle(tYaw - yawOf(camCF))
            local pitchErr = tPitch - pitchOf(camCF)
            if math.abs(yawErr) < 0.03 and math.abs(pitchErr) < 0.03 then
                AutoNormalAligned = true
            else
                MoveMouse(yawErr / calX, pitchErr / calY)
            end
        end
    end
end)

