local ItemESP = {}
local function CreateItemESP(Item)
    if ItemESP[Item] then return end
    local txt = Drawing.new("Text")
    txt.Center, txt.Outline, txt.Size = true, true, 13
    ItemESP[Item] = txt
end
local function RemoveItemESP(Item)
    local t = ItemESP[Item]
    if t then pcall(function() t:Remove() end) ItemESP[Item] = nil end
end
for _, Item in pairs(Items:GetChildren()) do CreateItemESP(Item) end
Add(Items.ChildAdded:Connect(CreateItemESP))
Add(Items.ChildRemoved:Connect(RemoveItemESP))

Add(RunService.RenderStepped:Connect(function()
    for Item, txt in pairs(ItemESP) do
        local part = Item.PrimaryPart or Item:FindFirstChildWhichIsA("BasePart")
        if not Toggles.ItemESPEnabled.Value or not part or not Options.ItemList.Value[Item.Name] then
            txt.Visible = false continue
        end
        local pos, on = Camera:WorldToViewportPoint(part.Position)
        local dist = (Camera.CFrame.Position - part.Position).Magnitude
        if not on or (Toggles.ItemDistCheck.Value and dist > Options.ItemDistance.Value) then
            txt.Visible = false continue
        end
        txt.Visible = true
        txt.Text = string.format("%s [%dm]", Item.Name, math.floor(dist))
        txt.Position = Vector2.new(pos.X, pos.Y)
        txt.Color = Options.ItemColor.Value
    end
end))

