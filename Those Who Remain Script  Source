local Store = {}
local State = { Shadows = false, Particles = false, Trails = false, Materials = false, Textures = false, Lights = false }
local LOD = { Enabled = false, Nametags = false, NearDist = 60, FarDist = 180, Interval = 0.25 }
local Characters = {}
local Running = true

local function Save(layer, inst, prop)
    Store[layer] = Store[layer] or {}
    local t = Store[layer]
    t[inst] = t[inst] or {}
    if t[inst][prop] == nil then
        local ok, v = pcall(function() return inst[prop] end)
        if ok then t[inst][prop] = v end
    end
end
local function Apply(layer, inst, prop, value)
    Save(layer, inst, prop)
    pcall(function() inst[prop] = value end)
end
local function Revert(layer)
    local t = Store[layer]
    if not t then return end
    local n = 0
    for inst, props in pairs(t) do
        if inst and inst.Parent then
            for prop, v in pairs(props) do pcall(function() inst[prop] = v end) end
        end
        n = n + 1
        if n % 300 == 0 then task.wait() end
    end
    Store[layer] = nil
end
local function RevertAll()
    for layer in pairs(Store) do Revert(layer) end
    for model in pairs(Characters) do
        if model.Parent then
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") then pcall(function() d.LocalTransparencyModifier = 0 end) end
            end
        end
    end
end

local function IsProtected(inst)
    local char = LocalPlayer.Character
    if char and inst:IsDescendantOf(char) then return true end
    if inst:IsDescendantOf(LocalPlayer) then return true end
    if inst:FindFirstAncestorWhichIsA("Tool") then return true end
    return false
end

local PARTICLE_CLASSES = { ParticleEmitter = true, Smoke = true, Fire = true, Sparkles = true }
local TRAIL_CLASSES = { Trail = true, Beam = true }
local LIGHT_CLASSES = { PointLight = true, SpotLight = true, SurfaceLight = true }

local function HandleInstance(inst)
    if not inst or not inst.Parent then return end
    local class = inst.ClassName
    if State.Particles and PARTICLE_CLASSES[class] and not IsProtected(inst) then
        Apply("Particles", inst, "Enabled", false)
        if class == "ParticleEmitter" then Apply("Particles", inst, "Rate", 0) end
    end
    if State.Trails and TRAIL_CLASSES[class] and not IsProtected(inst) then
        Apply("Trails", inst, "Enabled", false)
    end
    if State.Lights and LIGHT_CLASSES[class] and not IsProtected(inst) then
        Apply("Lights", inst, "Enabled", false)
    end
    if State.Textures and (class == "Decal" or class == "Texture") and not IsProtected(inst) then
        Apply("Textures", inst, "Transparency", 1)
    end
    if inst:IsA("BasePart") then
        if IsProtected(inst) then return end
        if State.Shadows then Apply("Shadows", inst, "CastShadow", false) end
        if State.Materials then
            Apply("Materials", inst, "Material", Enum.Material.SmoothPlastic)
            Apply("Materials", inst, "Reflectance", 0)
        end
    end
end
local function FullScan()
    local desc = Workspace:GetDescendants()
    local n = 0
    for _, inst in ipairs(desc) do
        HandleInstance(inst)
        n = n + 1
        if n % 400 == 0 then task.wait() end
    end
end
local function SetLayer(layer, enabled)
    State[layer] = enabled
    if enabled then task.spawn(FullScan) else task.spawn(function() Revert(layer) end) end
end

local function SetLighting(on)
    if on then
        Apply("Lighting", Lighting, "GlobalShadows", false)
        Apply("Lighting", Lighting, "EnvironmentDiffuseScale", 0)
        Apply("Lighting", Lighting, "EnvironmentSpecularScale", 0)
        Apply("Lighting", Lighting, "FogEnd", 100000)
        Apply("Lighting", Lighting, "ShadowSoftness", 0)
        return pcall(function()
            if sethiddenproperty then sethiddenproperty(Lighting, "Technology", 2)
            else Lighting.Technology = Enum.Technology.Voxel end
        end)
    else
        Revert("Lighting")
        return true
    end
end
local function SetPostEffects(on)
    if on then
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("PostEffect") then Apply("Post", v, "Enabled", false)
            elseif v:IsA("Atmosphere") then
                Apply("Post", v, "Density", 0) Apply("Post", v, "Haze", 0) Apply("Post", v, "Glare", 0)
            end
        end
    else Revert("Post") end
end
local function SetTerrain(on)
    if not Terrain then return end
    if on then
        Apply("Terrain", Terrain, "WaterWaveSize", 0)
        Apply("Terrain", Terrain, "WaterWaveSpeed", 0)
        Apply("Terrain", Terrain, "WaterReflectance", 0)
        Apply("Terrain", Terrain, "Decoration", false)
        local clouds = Terrain:FindFirstChildOfClass("Clouds")
        if clouds then Apply("Terrain", clouds, "Enabled", false) end
    else Revert("Terrain") end
end

local function RegisterHumanoid(hum)
    local model = hum.Parent
    if not model or not model:IsA("Model") then return end
    if model == LocalPlayer.Character then return end
    if Characters[model] then return end
    Characters[model] = { hum = hum, state = "init" }
end
local function ApplyLODState(model, state)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            local hide = false
            if state == "far" then hide = true
            elseif state == "mid" then hide = d:FindFirstAncestorWhichIsA("Accessory") ~= nil end
            pcall(function() d.LocalTransparencyModifier = hide and 1 or 0 end)
        end
    end
end
local function LODStep()
    local camPos = Camera.CFrame.Position
    local near2 = LOD.NearDist * LOD.NearDist
    local far2 = LOD.FarDist * LOD.FarDist
    for model, data in pairs(Characters) do
        if not model.Parent then Characters[model] = nil
        else
            local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if root then
                local d2 = (root.Position - camPos).Magnitude
                d2 = d2 * d2
                local newState
                if d2 <= near2 then newState = "near"
                elseif d2 <= far2 then newState = "mid"
                else newState = "far" end
                if newState ~= data.state then
                    data.state = newState
                    ApplyLODState(model, newState)
                end
            end
        end
    end
end
local function SetNametags(on)
    if on then
        for model, data in pairs(Characters) do
            if model.Parent and data.hum then
                Apply("Nametag", data.hum, "DisplayDistanceType", Enum.HumanoidDisplayDistanceType.None)
            end
        end
    else Revert("Nametag") end
end

